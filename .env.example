# Entorno de ejecución: development | test | production (obligatorio)
NODE_ENV=development

# Puerto en el que escucha la API (por defecto 8080)
PORT=8080

# URI de conexión a MongoDB (obligatorio)
MONGODB_URI=mongodb://localhost:27017/shipnow

# Nivel de logs: fatal | error | warning | info | http | debug
# Si se omite: debug en development, info en production, error en test
LOG_LEVEL=debug

# Habilita los endpoints internos de mocks (/api/mocks): true | false
# Si se omite: true fuera de producción, false en producción.
# Se controla con este flag y no con NODE_ENV, para poder habilitarlos
# en un contenedor de producción sin cambiar el entorno de la app.
ENABLE_MOCKS=true

# Orígenes permitidos por CORS, separados por coma.
# Vacío en desarrollo => se usan los orígenes locales por defecto.
CORS_ORIGINS=http://localhost:5173

# Secreto para firmar los JWT (se usará a partir del módulo de autenticación)
JWT_SECRET=

# URLs de servicios externos
# TRACKING_SERVICE_URL=
